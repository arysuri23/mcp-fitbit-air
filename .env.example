# Copy to .env and fill in your values. .env is gitignored — never commit it.
#
# Both come from the OAuth client you created in Google Cloud Console under
# Google Auth Platform -> Clients, as a "Desktop app" client.

FITBIT_MCP_CLIENT_ID=
FITBIT_MCP_CLIENT_SECRET=

# Optional. Where the refresh token is stored after `mcp-fitbit-air auth`.
# Defaults to ~/.config/mcp-fitbit-air/token.json
# FITBIT_MCP_TOKEN_PATH=
